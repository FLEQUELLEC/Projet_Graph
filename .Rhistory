# 📦 Chargement des packages nécessaires
library(ade4)
library(rgl)
# 🔢 Sélection des colonnes numériques pour l'ACP
# Assure-toi que madata_num contient bien : A, M, Mascotscore
madata_num <- madata[, c("A", "M", "Mascotscore")]
# 📊 ACP sur 3 axes (100 % d'inertie si 3 variables)
acp3d <- dudi.pca(madata_num, scannf = FALSE, nf = 3)
# 🎯 Coordonnées des variables (vecteurs du cercle de corrélation)
cor_var <- acp3d$c1[, 1:3]  # colonnes CS1, CS2, CS3
# 🖼️ Initialisation de la vue 3D
open3d()
bg3d(color = "white")  # fond blanc
view3d(theta = 30, phi = 20, zoom = 0.8)
# ⚪ Tracer la sphère (cercle de corrélation étendu à 3D)
spheres3d(0, 0, 0, radius = 1, color = "gray90", alpha = 0.2)
# ➕ Ajouter les axes (boîte de l’espace)
axes3d(edges = "bbox", col = "black", labels = TRUE)
# ➤ Tracer les flèches et labels des variables
for (i in 1:nrow(cor_var)) {
v <- cor_var[i, ]
segments3d(rbind(c(0, 0, 0), v), col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var)[i], col = "black", adj = 1.2)
}
# 🖼️ Initialisation de la vue 3D
open3d()
bg3d(color = "white")  # fond blanc
view3d(theta = 30, phi = 20, zoom = 0.8)
# ⚪ Tracer la sphère (cercle de corrélation étendu à 3D)
spheres3d(0, 0, 0, radius = 1, color = "gray90", alpha = 0.2)
# ➕ Ajouter les axes (boîte de l’espace)
axes3d(edges = "bbox", col = "black", labels = TRUE)
# Récupérer le % d'inertie expliquée pour chaque axe
eig <- round(acp3d$eig / sum(acp3d$eig) * 100, 1)
# Ajouter les noms des axes avec pourcentages
mtext3d(paste0("Axe 1 (", eig[1], " %)"), edge = "x--", line = 2)
mtext3d(paste0("Axe 2 (", eig[2], " %)"), edge = "y--", line = 2)
mtext3d(paste0("Axe 3 (", eig[3], " %)"), edge = "z--", line = 2)
# ➤ Tracer les flèches et labels des variables
for (i in 1:nrow(cor_var)) {
v <- cor_var[i, ]
segments3d(rbind(c(0, 0, 0), v), col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var)[i], col = "black", adj = 1.2)
}
