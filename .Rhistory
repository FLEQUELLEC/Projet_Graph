mutate(Mascotscore = Mascotscore)
madata42$Mascotscore <- gsub(".*Mascot Score,([0-9\\.]+)\\]", "\\1", madata42$Mascotscore)
madata62$Mascotscore <- gsub(".*Mascot Score,([0-9\\.]+)\\]", "\\1", madata62$Mascotscore)
