library(ade4)
library(rgl)
library(ade4)
library(rgl)
# On suppose que madata_num contient uniquement les colonnes numériques (ex : A et M)
acp3d <- dudi.pca(madata_num, scannf = FALSE, nf = 3)
# Coordonnées des variables sur les 3 axes principaux
cor_var <- acp3d$c1[, 1:3]
# Initialiser la vue
open3d()
rgl.bg(color = "white")
rgl.bg3d(color = "white")
bg3d(color = "white")
rgl.viewpoint(theta = 30, phi = 20, zoom = 0.8)
viewpoint3d(theta = 30, phi = 20, zoom = 0.8)
view3d(theta = 30, phi = 20, zoom = 0.8)
# Tracer la sphère (rayon = 1)
spheres3d(0, 0, 0, radius = 1, color = "gray90", alpha = 0.2)
# Tracer les flèches (vecteurs des variables)
apply(cor_var, 1, function(v) {
arrows3d(0, 0, 0, v[1], v[2], v[3], col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var), adj = 1.2)
})
# Tracer les flèches (vecteurs des variables)
apply(cor_var, 1, function(v) {
arrow3d(0, 0, 0, v[1], v[2], v[3], col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var), adj = 1.2)
})
# Ajouter axes
axes3d(edges = "bbox", col = "black", labels = TRUE)
# Tracer les flèches (vecteurs des variables)
apply(cor_var, 1, function(v) {
arrow3d(0, 0, 0, v[1], v[2], v[3], col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var), adj = 1.2)
})
arrow3d()
# Tracer les flèches (vecteurs des variables)
# Afficher chaque vecteur (ligne de cor_var) partant de (0,0,0)
apply(cor_var, 1, function(v) {
segments3d(rbind(c(0, 0, 0), v), col = "blue", lwd = 2)
text3d(v[1], v[2], v[3], texts = rownames(cor_var), col = "black", adj = 1.2)
})
# Ajouter axes
axes3d(edges = "bbox", col = "black", labels = TRUE)
