\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        bool}
\PYG{l+s+sd}{            True si l’arête (n1, n2) existe, False sinon.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{k}{return} \PYG{n}{n1} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges} \PYG{o+ow}{and} \PYG{n}{n2} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{n1}\PYG{p}{]}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{add\PYGZus{}edge}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{node\PYGZus{}id1}\PYG{p}{,} \PYG{n}{node\PYGZus{}id2}\PYG{p}{,} \PYG{n}{attributes}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Ajoute une arête entre deux nœuds. Crée les nœuds automatiquement s\PYGZsq{}ils manquent.}

\PYG{l+s+sd}{        Si le graphe est non dirigé, l\PYGZsq{}arête est ajoutée dans les deux sens}
\PYG{l+s+sd}{        (node\PYGZus{}id1 \PYGZhy{}\PYGZgt{} node\PYGZus{}id2 et node\PYGZus{}id2 \PYGZhy{}\PYGZgt{} node\PYGZus{}id1) partageant les mêmes attributs.}

\PYG{l+s+sd}{        Parameters}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        node\PYGZus{}id1 : str or int}
\PYG{l+s+sd}{            Identifiant du nœud source.}
\PYG{l+s+sd}{        node\PYGZus{}id2 : str or int}
\PYG{l+s+sd}{            Identifiant du nœud cible.}
\PYG{l+s+sd}{        attributes : dict, optional}
\PYG{l+s+sd}{            Dictionnaire d’attributs de l’arête.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        dict}
\PYG{l+s+sd}{            Dictionnaire des attributs de l’arête ajoutée.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{add\PYGZus{}node}\PYG{p}{(}\PYG{n}{node\PYGZus{}id1}\PYG{p}{)}
        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{add\PYGZus{}node}\PYG{p}{(}\PYG{n}{node\PYGZus{}id2}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} On évite d\PYGZsq{}écraser une arête existante sauf si nécessaire}
        \PYG{k}{if} \PYG{o+ow}{not} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edge\PYGZus{}exists}\PYG{p}{(}\PYG{n}{node\PYGZus{}id1}\PYG{p}{,} \PYG{n}{node\PYGZus{}id2}\PYG{p}{):}
            \PYG{n}{attr} \PYG{o}{=} \PYG{n}{attributes} \PYG{o+ow}{or} \PYG{p}{\PYGZob{}\PYGZcb{}}
            \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{node\PYGZus{}id1}\PYG{p}{][}\PYG{n}{node\PYGZus{}id2}\PYG{p}{]} \PYG{o}{=} \PYG{n}{attr}

            \PYG{k}{if} \PYG{o+ow}{not} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed}\PYG{p}{:}
                \PYG{c+c1}{\PYGZsh{} Partage de la référence du dictionnaire d\PYGZsq{}attributs}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{node\PYGZus{}id2}\PYG{p}{][}\PYG{n}{node\PYGZus{}id1}\PYG{p}{]} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{node\PYGZus{}id1}\PYG{p}{][}\PYG{n}{node\PYGZus{}id2}\PYG{p}{]}

        \PYG{k}{return} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{node\PYGZus{}id1}\PYG{p}{][}\PYG{n}{node\PYGZus{}id2}\PYG{p}{]}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{get\PYGZus{}nodes}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Renvoie la liste triée des identifiants de nœuds du graphe.}
\PYG{l+s+sd}{        (Renommé de \PYGZsq{}nodes\PYGZsq{} pour éviter la confusion avec l\PYGZsq{}attribut self.nodes).}

\PYG{l+s+sd}{        Returns}
