        \PYG{c+c1}{\PYGZsh{} Lecture optimisée avec Polars}
        \PYG{k}{try}\PYG{p}{:}
            \PYG{n}{df} \PYG{o}{=} \PYG{n}{pl}\PYG{o}{.}\PYG{n}{read\PYGZus{}csv}\PYG{p}{(}
                \PYG{n}{filename}\PYG{p}{,}
