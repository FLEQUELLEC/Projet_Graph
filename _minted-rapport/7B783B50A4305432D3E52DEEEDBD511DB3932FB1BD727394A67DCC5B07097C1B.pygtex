    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{BFS}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{s}\PYG{p}{,} \PYG{n}{cible}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Algorithme de parcours en largeur (Breadth\PYGZhy{}First Search).}
\PYG{l+s+sd}{        Calcule les plus courts chemins (en nombre d\PYGZsq{}arêtes) depuis une source.}

\PYG{l+s+sd}{        Parameters}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        s : str or int}
\PYG{l+s+sd}{            Sommet de départ.}
\PYG{l+s+sd}{        cible : str or int, optional}
\PYG{l+s+sd}{            Sommet d\PYGZsq{}arrivée. Si spécifié, l\PYGZsq{}algorithme s\PYGZsq{}arrête dès qu\PYGZsq{}il est trouvé.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        dict}
\PYG{l+s+sd}{            Si cible est trouvée : \PYGZob{}\PYGZsq{}Distance\PYGZsq{}: int, \PYGZsq{}chemin\PYGZsq{}: list, \PYGZsq{}source\PYGZsq{}: s\PYGZcb{}}
\PYG{l+s+sd}{            Sinon (parcours complet) : \PYGZob{}\PYGZsq{}etats\PYGZsq{}: dict, \PYGZsq{}distances\PYGZsq{}: dict, \PYGZsq{}parents\PYGZsq{}: dict, \PYGZsq{}source\PYGZsq{}: s\PYGZcb{}}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{k}{if} \PYG{n}{s} \PYG{o+ow}{not} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Erreur : Le nœud de départ }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{s}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{ n\PYGZsq{}existe pas.\PYGZdq{}}\PYG{p}{)}
            \PYG{k}{return} \PYG{p}{\PYGZob{}\PYGZcb{}}

        \PYG{c+c1}{\PYGZsh{} Initialisation}
        \PYG{n}{etats} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{n}{u}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}blanc\PYGZsq{}} \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{\PYGZcb{}}
        \PYG{n}{distances} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{n}{u}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}inf\PYGZsq{}}\PYG{p}{)} \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{\PYGZcb{}}
        \PYG{n}{parents} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{n}{u}\PYG{p}{:} \PYG{k+kc}{None} \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{\PYGZcb{}}

        \PYG{n}{etats}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}gris\PYGZsq{}}  \PYG{c+c1}{\PYGZsh{} En cours de visite}
        \PYG{n}{distances}\PYG{p}{[}\PYG{n}{s}\PYG{p}{]} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{n}{attente} \PYG{o}{=} \PYG{p}{[}\PYG{n}{s}\PYG{p}{]}      \PYG{c+c1}{\PYGZsh{} File (FIFO)}

        \PYG{k}{while} \PYG{n}{attente}\PYG{p}{:}
            \PYG{n}{u} \PYG{o}{=} \PYG{n}{attente}\PYG{o}{.}\PYG{n}{pop}\PYG{p}{(}\PYG{l+m+mi}{0}\PYG{p}{)}

            \PYG{k}{if} \PYG{n}{cible} \PYG{o+ow}{and} \PYG{n}{u} \PYG{o}{==} \PYG{n}{cible}\PYG{p}{:}
                \PYG{k}{break}

            \PYG{k}{for} \PYG{n}{voisin} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{neighbors}\PYG{p}{(}\PYG{n}{u}\PYG{p}{):}
                \PYG{k}{if} \PYG{n}{etats}\PYG{p}{[}\PYG{n}{voisin}\PYG{p}{]} \PYG{o}{==} \PYG{l+s+s1}{\PYGZsq{}blanc\PYGZsq{}}\PYG{p}{:}
                    \PYG{n}{etats}\PYG{p}{[}\PYG{n}{voisin}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}gris\PYGZsq{}}
                    \PYG{n}{distances}\PYG{p}{[}\PYG{n}{voisin}\PYG{p}{]} \PYG{o}{=} \PYG{n}{distances}\PYG{p}{[}\PYG{n}{u}\PYG{p}{]} \PYG{o}{+} \PYG{l+m+mi}{1}
                    \PYG{n}{parents}\PYG{p}{[}\PYG{n}{voisin}\PYG{p}{]} \PYG{o}{=} \PYG{n}{u}
                    \PYG{n}{attente}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{voisin}\PYG{p}{)}

            \PYG{n}{etats}\PYG{p}{[}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}noir\PYGZsq{}}  \PYG{c+c1}{\PYGZsh{} Visité}

        \PYG{c+c1}{\PYGZsh{} Reconstruction du chemin si une cible était demandée}
        \PYG{k}{if} \PYG{n}{cible}\PYG{p}{:}
            \PYG{k}{if} \PYG{n}{parents}\PYG{p}{[}\PYG{n}{cible}\PYG{p}{]} \PYG{o+ow}{is} \PYG{o+ow}{not} \PYG{k+kc}{None} \PYG{o+ow}{or} \PYG{n}{cible} \PYG{o}{==} \PYG{n}{s}\PYG{p}{:}
                \PYG{n}{chemin} \PYG{o}{=} \PYG{p}{[}\PYG{n}{cible}\PYG{p}{]}
                \PYG{n}{curr} \PYG{o}{=} \PYG{n}{cible}
                \PYG{k}{while} \PYG{n}{curr} \PYG{o}{!=} \PYG{n}{s}\PYG{p}{:}
                    \PYG{n}{curr} \PYG{o}{=} \PYG{n}{parents}\PYG{p}{[}\PYG{n}{curr}\PYG{p}{]}
                    \PYG{n}{chemin}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{curr}\PYG{p}{)}
                \PYG{n}{chemin}\PYG{o}{.}\PYG{n}{reverse}\PYG{p}{()}
                \PYG{k}{return} \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}Distance\PYGZdq{}}\PYG{p}{:} \PYG{n}{distances}\PYG{p}{[}\PYG{n}{cible}\PYG{p}{],} \PYG{l+s+s2}{\PYGZdq{}chemin\PYGZdq{}}\PYG{p}{:} \PYG{n}{chemin}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}source\PYGZdq{}}\PYG{p}{:} \PYG{n}{s}\PYG{p}{\PYGZcb{}}
            \PYG{k}{else}\PYG{p}{:}
                \PYG{k}{return} \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}Distance\PYGZdq{}}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}inf\PYGZsq{}}\PYG{p}{),} \PYG{l+s+s2}{\PYGZdq{}chemin\PYGZdq{}}\PYG{p}{:} \PYG{p}{[],} \PYG{l+s+s2}{\PYGZdq{}source\PYGZdq{}}\PYG{p}{:} \PYG{n}{s}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}error\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}Cible inatteignable\PYGZdq{}}\PYG{p}{\PYGZcb{}}

        \PYG{k}{return} \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}etats\PYGZdq{}}\PYG{p}{:} \PYG{n}{etats}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}distances\PYGZdq{}}\PYG{p}{:} \PYG{n}{distances}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}parents\PYGZdq{}}\PYG{p}{:} \PYG{n}{parents}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}source\PYGZdq{}}\PYG{p}{:} \PYG{n}{s}\PYG{p}{\PYGZcb{}}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{connected\PYGZus{}components}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Identifie les composantes connexes d’un graphe NON orienté via BFS.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        dict}
\PYG{l+s+sd}{            Dictionnaire \PYGZob{}node\PYGZus{}id: component\PYGZus{}id\PYGZcb{}.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{k}{if} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed}\PYG{p}{:}
            \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Attention : connected\PYGZus{}components est conçu pour les graphes non orientés.\PYGZdq{}}\PYG{p}{)}
            \PYG{c+c1}{\PYGZsh{} On continue quand même, mais le résultat représente des composantes faiblement connexes}
            \PYG{c+c1}{\PYGZsh{} si on ignore la direction, ou juste l\PYGZsq{}accessibilité si on la garde.}

        \PYG{n}{n\PYGZus{}CC} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{n}{CC} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{n}{u}\PYG{p}{:} \PYG{k+kc}{None} \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{\PYGZcb{}}

        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
            \PYG{k}{if} \PYG{n}{CC}\PYG{p}{[}\PYG{n}{u}\PYG{p}{]} \PYG{o+ow}{is} \PYG{k+kc}{None}\PYG{p}{:}
                \PYG{c+c1}{\PYGZsh{} On lance un BFS complet depuis ce nœud non visité}
                \PYG{n}{parcours} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{BFS}\PYG{p}{(}\PYG{n}{u}\PYG{p}{)}

                \PYG{c+c1}{\PYGZsh{} Tous les nœuds atteints appartiennent à la composante n\PYGZus{}CC}
                \PYG{c+c1}{\PYGZsh{} Le BFS retourne \PYGZsq{}distances\PYGZsq{} pour les nœuds visités}
                \PYG{n}{visited\PYGZus{}nodes} \PYG{o}{=} \PYG{p}{[}\PYG{n}{n} \PYG{k}{for} \PYG{n}{n}\PYG{p}{,} \PYG{n}{d} \PYG{o+ow}{in} \PYG{n}{parcours}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}distances\PYGZsq{}}\PYG{p}{]}\PYG{o}{.}\PYG{n}{items}\PYG{p}{()} \PYG{k}{if} \PYG{n}{d} \PYG{o}{!=} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}inf\PYGZsq{}}\PYG{p}{)]}

                \PYG{k}{for} \PYG{n}{v} \PYG{o+ow}{in} \PYG{n}{visited\PYGZus{}nodes}\PYG{p}{:}
                    \PYG{n}{CC}\PYG{p}{[}\PYG{n}{v}\PYG{p}{]} \PYG{o}{=} \PYG{n}{n\PYGZus{}CC}
                \PYG{n}{n\PYGZus{}CC} \PYG{o}{+=} \PYG{l+m+mi}{1}
        \PYG{k}{return} \PYG{n}{CC}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{sousgraphe\PYGZus{}induit}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{nodes\PYGZus{}subset}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Crée un sous\PYGZhy{}graphe induit par une liste de nœuds donnée.}

\PYG{l+s+sd}{        Parameters}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        nodes\PYGZus{}subset : list}
\PYG{l+s+sd}{            Liste des identifiants de nœuds à conserver.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        graph}
\PYG{l+s+sd}{            Nouveau graphe contenant uniquement les nœuds spécifiés et les arêtes entre eux.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{sg} \PYG{o}{=} \PYG{n}{graph}\PYG{p}{(}
            \PYG{n}{directed}\PYG{o}{=}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed}\PYG{p}{,}
            \PYG{n}{weighted}\PYG{o}{=}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weighted}\PYG{p}{,}
            \PYG{n}{weight\PYGZus{}attribute}\PYG{o}{=}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weight\PYGZus{}attribute}
        \PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Ajout des nœuds}
        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n}{nodes\PYGZus{}subset}\PYG{p}{:}
            \PYG{k}{if} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
                \PYG{n}{sg}\PYG{o}{.}\PYG{n}{add\PYGZus{}node}\PYG{p}{(}\PYG{n}{u}\PYG{p}{,} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{[}\PYG{n}{u}\PYG{p}{])}

        \PYG{c+c1}{\PYGZsh{} Ajout des arêtes existantes entre ces nœuds}
        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n}{nodes\PYGZus{}subset}\PYG{p}{:}
            \PYG{k}{if} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{:}
                \PYG{k}{for} \PYG{n}{v}\PYG{p}{,} \PYG{n}{attrs} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{u}\PYG{p}{]}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
                    \PYG{k}{if} \PYG{n}{v} \PYG{o+ow}{in} \PYG{n}{nodes\PYGZus{}subset}\PYG{p}{:}
                        \PYG{n}{sg}\PYG{o}{.}\PYG{n}{add\PYGZus{}edge}\PYG{p}{(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{,} \PYG{n}{attrs}\PYG{p}{)}

        \PYG{k}{return} \PYG{n}{sg}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{edges\PYGZus{}filter}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{attribut}\PYG{p}{,} \PYG{n}{seuil}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Filtre le graphe pour ne garder que les arêtes respectant un critère numérique.}

\PYG{l+s+sd}{        Parameters}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        attribut : str}
\PYG{l+s+sd}{            Nom de l\PYGZsq{}attribut de l\PYGZsq{}arête à tester (ex: \PYGZsq{}weight\PYGZsq{}).}
\PYG{l+s+sd}{        seuil : float}
\PYG{l+s+sd}{            Valeur minimale pour conserver l\PYGZsq{}arête.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        graph}
\PYG{l+s+sd}{            Nouveau graphe filtré.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{G\PYGZus{}filtre} \PYG{o}{=} \PYG{n}{graph}\PYG{p}{(}\PYG{n}{directed}\PYG{o}{=}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed}\PYG{p}{,} \PYG{n}{weighted}\PYG{o}{=}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{weighted}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} On copie tous les nœuds}
        \PYG{k}{for} \PYG{n}{node\PYGZus{}id}\PYG{p}{,} \PYG{n}{attrs} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
            \PYG{n}{G\PYGZus{}filtre}\PYG{o}{.}\PYG{n}{add\PYGZus{}node}\PYG{p}{(}\PYG{n}{node\PYGZus{}id}\PYG{p}{,} \PYG{n}{attrs}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} On ne copie que les arêtes valides}
        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{:}
            \PYG{k}{for} \PYG{n}{v}\PYG{p}{,} \PYG{n}{attrs} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{p}{[}\PYG{n}{u}\PYG{p}{]}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
                \PYG{k}{if} \PYG{n}{attribut} \PYG{o+ow}{in} \PYG{n}{attrs} \PYG{o+ow}{and} \PYG{n}{attrs}\PYG{p}{[}\PYG{n}{attribut}\PYG{p}{]} \PYG{o}{\PYGZgt{}=} \PYG{n}{seuil}\PYG{p}{:}
                    \PYG{n}{G\PYGZus{}filtre}\PYG{o}{.}\PYG{n}{add\PYGZus{}edge}\PYG{p}{(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{,} \PYG{n}{attrs}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{G\PYGZus{}filtre}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{clustering\PYGZus{}coefficient}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Calcule le coefficient de clustering local pour chaque nœud.}
\PYG{l+s+sd}{        C = (nombre de liens entre voisins) / (nombre de liens possibles entre voisins).}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        dict}
\PYG{l+s+sd}{            \PYGZob{}node\PYGZus{}id: coefficient (float entre 0 et 1)\PYGZcb{}}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{coeffs} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}
        \PYG{k}{for} \PYG{n}{node\PYGZus{}id} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
            \PYG{n}{voisins} \PYG{o}{=} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{neighbors}\PYG{p}{(}\PYG{n}{node\PYGZus{}id}\PYG{p}{)}
            \PYG{n}{k} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{voisins}\PYG{p}{)}

            \PYG{c+c1}{\PYGZsh{} Si moins de 2 voisins, pas de connexions possibles entre eux \PYGZhy{}\PYGZgt{} coeff = 0}
            \PYG{k}{if} \PYG{n}{k} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{2}\PYG{p}{:}
                \PYG{n}{coeffs}\PYG{p}{[}\PYG{n}{node\PYGZus{}id}\PYG{p}{]} \PYG{o}{=} \PYG{l+m+mf}{0.0}
                \PYG{k}{continue}

            \PYG{n}{liens\PYGZus{}reels} \PYG{o}{=} \PYG{l+m+mi}{0}
            \PYG{c+c1}{\PYGZsh{} On regarde toutes les paires de voisins uniques}
            \PYG{k}{for} \PYG{n}{v1} \PYG{o+ow}{in} \PYG{n}{voisins}\PYG{p}{:}
                \PYG{k}{for} \PYG{n}{v2} \PYG{o+ow}{in} \PYG{n}{voisins}\PYG{p}{:}
                    \PYG{k}{if} \PYG{n}{v1} \PYG{o}{!=} \PYG{n}{v2}\PYG{p}{:}
                        \PYG{k}{if} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edge\PYGZus{}exists}\PYG{p}{(}\PYG{n}{v1}\PYG{p}{,} \PYG{n}{v2}\PYG{p}{):}
                            \PYG{n}{liens\PYGZus{}reels} \PYG{o}{+=} \PYG{l+m+mi}{1}

            \PYG{c+c1}{\PYGZsh{} Nombre max de liens possibles entre k voisins}
            \PYG{c+c1}{\PYGZsh{} k * (k\PYGZhy{}1) pour dirigé, k * (k\PYGZhy{}1) / 2 pour non dirigé.}
            \PYG{c+c1}{\PYGZsh{} Ici l\PYGZsq{}algo compte v1\PYGZhy{}\PYGZgt{}v2 et v2\PYGZhy{}\PYGZgt{}v1 séparément dans la boucle,}
            \PYG{c+c1}{\PYGZsh{} donc on divise par k*(k\PYGZhy{}1) dans tous les cas pour normaliser.}
            \PYG{n}{coeffs}\PYG{p}{[}\PYG{n}{node\PYGZus{}id}\PYG{p}{]} \PYG{o}{=} \PYG{n}{liens\PYGZus{}reels} \PYG{o}{/} \PYG{p}{(}\PYG{n}{k} \PYG{o}{*} \PYG{p}{(}\PYG{n}{k} \PYG{o}{\PYGZhy{}} \PYG{l+m+mi}{1}\PYG{p}{))}

        \PYG{k}{return} \PYG{n}{coeffs}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{DFS}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Algorithme de parcours en profondeur (Depth\PYGZhy{}First Search).}
\PYG{l+s+sd}{        Utilisé pour la classification des arêtes, la détection de cycles et le tri topologique.}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        dict}
\PYG{l+s+sd}{            Structure contenant l\PYGZsq{}état du parcours, les temps de découverte/fin,}
\PYG{l+s+sd}{            la classification des arêtes et l\PYGZsq{}ordre de fin.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{a} \PYG{o}{=} \PYG{p}{\PYGZob{}}
            \PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}\PYGZcb{},}
            \PYG{l+s+s1}{\PYGZsq{}parents\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}\PYGZcb{},}
            \PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}\PYGZcb{},} \PYG{c+c1}{\PYGZsh{} Timestamp de début}
            \PYG{l+s+s1}{\PYGZsq{}fin\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}\PYGZcb{},}       \PYG{c+c1}{\PYGZsh{} Timestamp de fin}
            \PYG{l+s+s1}{\PYGZsq{}classification\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}\PYGZcb{},} \PYG{c+c1}{\PYGZsh{} Types d\PYGZsq{}arêtes}
            \PYG{l+s+s1}{\PYGZsq{}ordre\PYGZus{}fin\PYGZsq{}}\PYG{p}{:} \PYG{p}{[],} \PYG{c+c1}{\PYGZsh{} Liste pour tri topologique}
            \PYG{l+s+s1}{\PYGZsq{}temps\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{0}
        \PYG{p}{\PYGZcb{}}

        \PYG{c+c1}{\PYGZsh{} Initialisation}
        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
            \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}inexplore\PYGZsq{}}
            \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}parents\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{k+kc}{None}

        \PYG{c+c1}{\PYGZsh{} Boucle principale pour traiter les composantes disjointes}
        \PYG{k}{for} \PYG{n}{u} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{:}
            \PYG{k}{if} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{==} \PYG{l+s+s1}{\PYGZsq{}inexplore\PYGZsq{}}\PYG{p}{:}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}DFSvisite}\PYG{p}{(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{a}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{a}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}DFSvisite}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{,} \PYG{n}{u}\PYG{p}{,} \PYG{n}{a}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Fonction interne récursive pour le DFS.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}temps\PYGZsq{}}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}temps\PYGZsq{}}\PYG{p}{]}

        \PYG{k}{for} \PYG{n}{v} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{neighbors}\PYG{p}{(}\PYG{n}{u}\PYG{p}{):}
            \PYG{k}{if} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{v}\PYG{p}{]} \PYG{o}{==} \PYG{l+s+s1}{\PYGZsq{}inexplore\PYGZsq{}}\PYG{p}{:}
                \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}parents\PYGZsq{}}\PYG{p}{][}\PYG{n}{v}\PYG{p}{]} \PYG{o}{=} \PYG{n}{u}
                \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}classification\PYGZsq{}}\PYG{p}{][(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}branche\PYGZsq{}}
                \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{\PYGZus{}DFSvisite}\PYG{p}{(}\PYG{n}{v}\PYG{p}{,} \PYG{n}{a}\PYG{p}{)}
            \PYG{k}{elif} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{v}\PYG{p}{]} \PYG{o}{==} \PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}\PYG{p}{:}
                \PYG{c+c1}{\PYGZsh{} Arête vers un ancêtre non terminé \PYGZhy{}\PYGZgt{} Cycle détecté}
                \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}classification\PYGZsq{}}\PYG{p}{][(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}retour\PYGZsq{}}
            \PYG{k}{elif} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{\PYGZlt{}} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}decouvert\PYGZsq{}}\PYG{p}{][}\PYG{n}{v}\PYG{p}{]:}
                \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}classification\PYGZsq{}}\PYG{p}{][(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}arete avant\PYGZsq{}}
            \PYG{k}{else}\PYG{p}{:}
                \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}classification\PYGZsq{}}\PYG{p}{][(}\PYG{n}{u}\PYG{p}{,} \PYG{n}{v}\PYG{p}{)]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}transversale\PYGZsq{}} \PYG{c+c1}{\PYGZsh{} Cross edge}

        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}etat\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{l+s+s1}{\PYGZsq{}traite\PYGZsq{}}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}temps\PYGZsq{}}\PYG{p}{]} \PYG{o}{+=} \PYG{l+m+mi}{1}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}fin\PYGZsq{}}\PYG{p}{][}\PYG{n}{u}\PYG{p}{]} \PYG{o}{=} \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}temps\PYGZsq{}}\PYG{p}{]}

        \PYG{c+c1}{\PYGZsh{} Ajout à la liste pour le tri topologique (post\PYGZhy{}ordre)}
        \PYG{n}{a}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}ordre\PYGZus{}fin\PYGZsq{}}\PYG{p}{]}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{u}\PYG{p}{)}
        \PYG{k}{return} \PYG{n}{a}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{is\PYGZus{}acyclic}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Vérifie si le graphe est acyclique (DAG).}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        bool}
\PYG{l+s+sd}{            True si acyclique, False si contient un cycle.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
