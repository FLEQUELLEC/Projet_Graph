        \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}  \PYG{c+c1}{\PYGZsh{} Stocke les nœuds et leurs attributs : \PYGZob{}id: \PYGZob{}attr: val\PYGZcb{}\PYGZcb{}}
