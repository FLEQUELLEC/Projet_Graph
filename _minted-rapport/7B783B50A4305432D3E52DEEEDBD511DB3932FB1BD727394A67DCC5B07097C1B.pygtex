        \PYG{k}{return} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{)}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{nb\PYGZus{}edges}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Renvoie le nombre d\PYGZsq{}arêtes du graphe.}

\PYG{l+s+sd}{        Pour les graphes non dirigés, divise le total par 2 car chaque arête}
\PYG{l+s+sd}{        est stockée deux fois (u\PYGZhy{}\PYGZgt{}v et v\PYGZhy{}\PYGZgt{}u).}

\PYG{l+s+sd}{        Returns}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        int}
\PYG{l+s+sd}{            Nombre d\PYGZsq{}arêtes.}
\PYG{l+s+sd}{        \PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{count} \PYG{o}{=} \PYG{n+nb}{sum}\PYG{p}{(}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{v}\PYG{p}{)} \PYG{k}{for} \PYG{n}{v} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{o}{.}\PYG{n}{values}\PYG{p}{())}
        \PYG{k}{return} \PYG{n}{count} \PYG{o}{//} \PYG{l+m+mi}{2} \PYG{k}{if} \PYG{o+ow}{not} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed} \PYG{k}{else} \PYG{n}{count}

