            \PYG{k}{return} \PYG{n+nb+bp}{cls}\PYG{p}{()}

        \PYG{n}{cols} \PYG{o}{=} \PYG{n}{df}\PYG{o}{.}\PYG{n}{columns}
        \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{cols}\PYG{p}{)} \PYG{o}{\PYGZlt{}} \PYG{l+m+mi}{2}\PYG{p}{:}
            \PYG{k}{raise} \PYG{n+ne}{ValueError}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}Le fichier doit contenir au moins deux colonnes (source, target).\PYGZdq{}}\PYG{p}{)}

        \PYG{n}{src\PYGZus{}col}\PYG{p}{,} \PYG{n}{tgt\PYGZus{}col} \PYG{o}{=} \PYG{n}{cols}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{],} \PYG{n}{cols}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}
        \PYG{n}{att\PYGZus{}cols} \PYG{o}{=} \PYG{n}{cols}\PYG{p}{[}\PYG{l+m+mi}{2}\PYG{p}{:]}

        \PYG{c+c1}{\PYGZsh{} Création de l\PYGZsq{}instance}
        \PYG{n}{g} \PYG{o}{=} \PYG{n+nb+bp}{cls}\PYG{p}{(}\PYG{n}{directed}\PYG{o}{=}\PYG{n}{directed}\PYG{p}{,} \PYG{n}{weighted}\PYG{o}{=}\PYG{n}{weighted}\PYG{p}{,} \PYG{n}{weight\PYGZus{}attribute}\PYG{o}{=}\PYG{n}{weight\PYGZus{}attribute}\PYG{p}{)}

        \PYG{c+c1}{\PYGZsh{} Conversion en pandas pour l\PYGZsq{}itération (souvent plus simple pour les lignes mixtes)}
        \PYG{n}{pdf} \PYG{o}{=} \PYG{n}{df}\PYG{o}{.}\PYG{n}{to\PYGZus{}pandas}\PYG{p}{()}

        \PYG{k}{for} \PYG{n}{\PYGZus{}}\PYG{p}{,} \PYG{n}{row} \PYG{o+ow}{in} \PYG{n}{pdf}\PYG{o}{.}\PYG{n}{iterrows}\PYG{p}{():}
