    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{read\PYGZus{}delim}\PYG{p}{(}\PYG{n+nb+bp}{cls}\PYG{p}{,} \PYG{n}{filename}\PYG{p}{,} \PYG{n}{column\PYGZus{}separator}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+se}{\PYGZbs{}t}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{,} \PYG{n}{directed}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{,} \PYG{n}{weighted}\PYG{o}{=}\PYG{k+kc}{False}\PYG{p}{,} \PYG{n}{weight\PYGZus{}attribute}\PYG{o}{=}\PYG{k+kc}{None}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{        Lit un fichier délimité (ex: TSV, CSV) et construit un objet graph.}

\PYG{l+s+sd}{        Les deux premières colonnes représentent les nœuds connectés (Source, Target),}
\PYG{l+s+sd}{        les suivantes contiennent les attributs d’arêtes.}

\PYG{l+s+sd}{        Parameters}
\PYG{l+s+sd}{        \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZhy{}}
\PYG{l+s+sd}{        filename : str}
\PYG{l+s+sd}{            Chemin vers le fichier à lire.}
\PYG{l+s+sd}{        column\PYGZus{}separator : str, optional}
\PYG{l+s+sd}{            Caractère de séparation (par défaut : tabulation).}
