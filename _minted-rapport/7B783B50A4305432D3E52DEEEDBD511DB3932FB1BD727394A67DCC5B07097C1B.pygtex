    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf+fm}{\PYGZus{}\PYGZus{}str\PYGZus{}\PYGZus{}}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{p}{):}
\PYG{+w}{        }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Représentation textuelle du graphe.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
        \PYG{n}{lines} \PYG{o}{=} \PYG{p}{[}
            \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Graphe }\PYG{l+s+si}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}dirigé\PYGZsq{}}\PYG{+w}{ }\PYG{k}{if}\PYG{+w}{ }\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{directed}\PYG{+w}{ }\PYG{k}{else}\PYG{+w}{ }\PYG{l+s+s1}{\PYGZsq{}non dirigé\PYGZsq{}}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,}
            \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Nombre de nœuds : }\PYG{l+s+si}{\PYGZob{}}\PYG{n+nb}{len}\PYG{p}{(}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nodes}\PYG{p}{)}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,}
            \PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Nombre d\PYGZsq{}arêtes : }\PYG{l+s+si}{\PYGZob{}}\PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{nb\PYGZus{}edges}\PYG{p}{()}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{,}
            \PYG{l+s+s2}{\PYGZdq{}\PYGZhy{}\PYGZhy{}\PYGZhy{} Aperçu des arêtes \PYGZhy{}\PYGZhy{}\PYGZhy{}\PYGZdq{}}
        \PYG{p}{]}
        \PYG{c+c1}{\PYGZsh{} On limite l\PYGZsq{}affichage pour éviter de saturer la console sur les gros graphes}
        \PYG{n}{count} \PYG{o}{=} \PYG{l+m+mi}{0}
        \PYG{k}{for} \PYG{n}{u}\PYG{p}{,} \PYG{n}{targets} \PYG{o+ow}{in} \PYG{n+nb+bp}{self}\PYG{o}{.}\PYG{n}{edges}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
